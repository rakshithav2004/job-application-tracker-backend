# Environment Configuration Example
# Copy this to .env and fill in your actual values (DO NOT COMMIT .env to git)

# MongoDB Connection (local development default shown)
MONGODB_URI=mongodb://localhost:27017/jobtrackerdb

# JWT Configuration
# IMPORTANT: Generate a strong random secret key for production
# Example: openssl rand -base64 32
JWT_SECRET=your-very-secure-random-secret-key-min-32-chars-here

# Application Port
SERVER_PORT=8080

# Logging Levels
LOG_LEVEL_SPRING_SECURITY=DEBUG
LOG_LEVEL_APP=INFO

